        "status": {
          "enum": [
            "reported",
            "not_reported",
            "not_checked",
            "not_applicable"
          ]
        },
        "unit": {
          "enum": [
            "donor",
            "library",
            "section",
            "cell",
            "nucleus",
            "spot",
            "ROI",
            "cell_set",
            "gene",
            "model",
            "dataset",
            "not_applicable",
            "not_reported"
          ]
        },
        "population_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
