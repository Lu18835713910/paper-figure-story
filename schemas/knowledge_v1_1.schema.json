    "entities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entity"
      },
      "minItems": 0
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relation"
      },
      "minItems": 0
    },
    "figures": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/figure"
      },
      "minItems": 0
    },
    "stories": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/story"
      },
      "minItems": 0
    },
    "relation_groups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relation_group"
      },
      "minItems": 0
    },
    "relation_constraints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/constraint"
      },
      "minItems": 0
    },
    "quantity_operations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/quantity_operation"
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "model_status",
    "description",
    "document_registry",
    "paper_type",
    "entities",
    "relations",
    "figures",
    "stories",
    "relation_groups",
    "relation_constraints",
    "quantity_operations"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:paper-figure-story:knowledge:1.1",
