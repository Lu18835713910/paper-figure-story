{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://paper-figure-story.local/experiment_inventory_v1_1.schema.json",
  "title":"Additive source-bound full experimental inventory",
  "type":"object",
  "properties":{
    "version":{"const":"pfs-experiment-inventory-1"},
    "paper_id":{"type":"string","minLength":1},
    "knowledge_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "formal_ready":{"const":false},
    "counting_policy":{},
    "experiments":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/experiment"}},
    "method_sections":{"type":"array","items":{"type":"object"}},
    "missing_materials":{"type":"array","items":{}},
    "relations":{"type":"array","items":{"$ref":"#/$defs/relation"}}
  },
  "required":["version","paper_id","knowledge_sha256","experiments"],
  "additionalProperties":true,
  "$defs":{
    "source_ref":{
      "type":"object",
      "properties":{
        "document_id":{"type":"string","minLength":1},
        "physical_page":{"type":"integer","minimum":1},
        "path":{"type":"string","minLength":1},
        "sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
        "start":{"type":"integer","minimum":0},
        "end":{"type":"integer","minimum":1},
        "excerpt":{"type":"string","minLength":1}
      },
      "required":["document_id","physical_page","path","sha256","start","end","excerpt"],
      "additionalProperties":true
    },
    "field":{
      "type":"object",
      "properties":{
        "value":{},
        "status":{"enum":["VERIFIED","PARTIAL","NOT_REPORTED","NOT_VERIFIED","CONFLICT"]},
        "source_refs":{"type":"array","items":{"$ref":"#/$defs/source_ref"}},
        "unit":{},"reason":{"type":"string","minLength":1},"review_scope":{},"candidates":{}
      },
      "required":["value","status","source_refs"],"additionalProperties":true
    },
    "experiment":{
      "type":"object",
      "properties":{
        "experiment_id":{"type":"string","minLength":1,"pattern":"^[A-Za-z0-9_.-]+$"},
        "display_name":{"type":"string","minLength":1},
        "task_type":{"type":"string","minLength":1},
        "m1_evidence_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
        "figure_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
        "fields":{"type":"object","additionalProperties":true},
        "methods_refs":{"type":"array","items":{"$ref":"#/$defs/source_ref"}}
      },
      "required":["experiment_id","display_name","task_type","m1_evidence_ids","figure_ids","fields"],
      "additionalProperties":true
    },
    "relation":{
      "type":"object",
      "properties":{
        "id":{"type":"string","minLength":1},"from":{"type":"string","minLength":1},"to":{"type":"string","minLength":1},
        "type":{"type":"string","minLength":1},
        "identity":{"enum":["SCIENTIFIC_EVIDENCE","DATA_DEPENDENCY","EXPERIMENTAL_COMPARISON","AUTHOR_INTERPRETATION","PRESENTATION_ORDER","UNVERIFIED_HYPOTHESIS"]},
        "source_refs":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/source_ref"}},
        "causal_claim":{"const":false}
      },
      "required":["id","from","to","type","identity","source_refs"],"additionalProperties":true
    }
  }
}
