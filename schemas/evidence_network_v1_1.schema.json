                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "locator": {
                      "type": "object",
                      "properties": {
                        "physical_page": {
                          "type": "integer",
                          "minimum": 1
                        }
                      },
                      "required": [
                        "physical_page"
                      ],
                      "additionalProperties": false
                    },
                    "verification": {
                      "const": "pending"
                    },
                    "cache": {
                      "type": "object",
                      "properties": {
                        "path": {
                          "type": "string",
                          "minLength": 1
                        },
                        "sha256": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{64}$"
                        },
                        "start": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "end": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "excerpt": {
                          "type": "string",
                          "minLength": 1
                        },
                        "excerpt_sha256": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{64}$"
                        }
                      },
                      "required": [
                        "path",
                        "sha256",
                        "start",
                        "end",
                        "excerpt",
                        "excerpt_sha256"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "document_id",
                    "document_sha256",
                    "locator",
                    "verification",
                    "cache"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1
              },
              "review": {
                "type": "object",
                "properties": {
                  "source_status": {
                    "enum": [
                      "PASS_SCOPED",
                      "PARTIAL",
                      "NOT_TESTED"
                    ]
                  },
                  "text_support": {
                    "enum": [
                      "PARTIAL",
                      "NOT_TESTED"
                    ]
                  },
                  "panel_mapping": {
                    "enum": [
                      "NA",
                      "PARTIAL",
                      "NOT_TESTED"
                    ]
                  },
                  "image_visual": {
                    "enum": [
                      "NA",
                      "PARTIAL",
                      "NOT_TESTED"
                    ]
                  },
                  "semantic_review_status": {
                    "enum": [
                      "PARTIAL",
                      "NOT_TESTED"
                    ]
                  },
