                "minLength": 1
              },
              "semantic_type": {
                "enum": [
                  "uses",
                  "measures",
                  "derived_from",
                  "observes",
                  "supports",
                  "contradicts",
                  "validates_or_tests",
                  "depends_on",
                  "parallel_to",
                  "motivates",
                  "integrates",
                  "hypothesizes",
                  "compares",
                  "experimental_precedes"
                ]
              },
              "identity": {
                "enum": [
                  "association",
                  "data_dependency",
                  "experimental_order",
                  "evidence",
                  "mechanism_hypothesis",
                  "author_argument",
                  "presentation"
                ]
              },
              "source_refs": {
                "type": "array",
