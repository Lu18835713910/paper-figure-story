    "relation_annotations_input": {
      "type": "object",
      "properties": {
        "version": {
          "const": "pfs-relation-annotations-1"
        },
        "knowledge_snapshot": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "relations": {
          "type": "array",
