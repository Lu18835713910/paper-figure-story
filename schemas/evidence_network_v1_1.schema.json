                    "const": false
                  },
                  "formal_ready": {
                    "const": false
                  }
                },
                "required": [
                  "source_status",
                  "text_support",
                  "panel_mapping",
                  "image_visual",
                  "semantic_review_status",
                  "independent_scientific_review",
                  "formal_ready"
